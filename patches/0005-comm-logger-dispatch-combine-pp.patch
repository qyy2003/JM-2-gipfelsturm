--- /dev/null
+++ b/megatron/core/comm_logger.py
@@ -0,0 +1,294 @@
+# Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+"""Communication traffic logger for compute-network overlap analysis.
+
+Usage:
+  Set MEGATRON_COMM_LOG_DIR=/path/to/logdir before training.
+
+  Each rank writes: <logdir>/comm_rank<RRRR>.jsonl
+
+  To advance the step counter (call once per optimizer step):
+    from megatron.core.comm_logger import CommLogger
+    CommLogger.get().next_step()
+
+  Each JSON line has:
+    step, rank, name, gpu_ms, wall_start_us, wall_end_us, wall_dur_us,
+    send_bytes, recv_bytes, send_MB, recv_MB
+
+  'name' examples:
+    MoE-DISPATCH-FWD, MoE-DISPATCH-BWD
+    MoE-COMBINE-FWD,  MoE-COMBINE-BWD
+    PP-forward-recv,  PP-forward-send
+    PP-backward-recv, PP-backward-send
+    PP-fwd-send-bwd-recv, PP-bwd-send-fwd-recv
+"""
+
+import atexit
+import json
+import os
+import socket
+import threading
+import time
+from collections import deque
+from contextlib import contextmanager
+from typing import List, Optional
+
+import torch
+import torch.distributed as dist
+
+# Thread-local store for the "next A2A label" that callers set before each call.
+_tls = threading.local()
+
+
+def set_comm_label(label: str) -> None:
+    """Set the semantic label that will be consumed by the next _AllToAll call."""
+    _tls.label = label
+
+
+def pop_comm_label(default: str = "A2A-FWD") -> str:
+    """Retrieve and clear the pending label; return *default* if none was set."""
+    label = getattr(_tls, "label", default)
+    _tls.label = default
+    return label
+
+
+@contextmanager
+def logging_comm(name: str, group, send_bytes: int, recv_bytes: int):
+    """Bracket a single torch.distributed call so its launch is logged.
+
+    Usage:
+        with logging_comm("TP-AR", group, input_.nbytes, input_.nbytes):
+            torch.distributed.all_reduce(input_.contiguous(), group=group)
+
+    The peer list is `torch.distributed.get_process_group_ranks(group)`. Same
+    caveats as elsewhere in this logger: async collectives produce a `gpu_ms`
+    that only captures launch overhead, not the actual transfer time.
+    """
+    logger = CommLogger.get()
+    if not logger.enabled:
+        yield
+        return
+    start_ev = torch.cuda.Event(enable_timing=True)
+    end_ev = torch.cuda.Event(enable_timing=True)
+    wall_start = time.perf_counter_ns()
+    start_ev.record()
+    try:
+        yield
+    finally:
+        end_ev.record()
+        wall_end = time.perf_counter_ns()
+        peers = None
+        if group is not None:
+            try:
+                peers = torch.distributed.get_process_group_ranks(group)
+            except Exception:
+                pass
+        logger.record_scalar(
+            name, int(send_bytes), int(recv_bytes),
+            start_ev, end_ev, wall_start, wall_end, peers=peers,
+        )
+
+
+class CommLogger:
+    """Singleton that collects communication events and writes them to JSONL.
+
+    GPU timing is deferred: each call enqueues the (start, end) CUDA events and the
+    partially-built record. The queue is drained in FIFO order whenever the head's
+    end event is complete (non-blocking query), so we never stall the CPU on a GPU
+    event that is still in flight. flush() and close() force a blocking drain.
+    """
+
+    _instance: Optional["CommLogger"] = None
+    _lock = threading.Lock()
+
+    @classmethod
+    def get(cls) -> "CommLogger":
+        if cls._instance is None:
+            with cls._lock:
+                if cls._instance is None:
+                    cls._instance = cls()
+        return cls._instance
+
+    def __init__(self) -> None:
+        self._log_dir: str = os.environ.get("MEGATRON_COMM_LOG_DIR", "")
+        self._enabled: bool = bool(self._log_dir)
+        self._rank: int = -1
+        self._local_rank: int = -1
+        self._local_world_size: int = -1
+        self._world_size: int = -1
+        self._node_id: int = -1
+        self._hostname: str = ""
+        self._step: int = 0
+        self._file = None
+        self._init_done: bool = False
+        # Each entry: (record_dict_without_gpu_ms, start_event, end_event)
+        self._pending: "deque" = deque()
+
+    # ------------------------------------------------------------------
+    # Public API
+    # ------------------------------------------------------------------
+
+    @property
+    def enabled(self) -> bool:
+        return self._enabled
+
+    def next_step(self) -> None:
+        """Advance the global training-step counter by one."""
+        self._step += 1
+
+    def set_step(self, step: int) -> None:
+        self._step = step
+
+    def record(
+        self,
+        name: str,
+        send_tensor: Optional[torch.Tensor],
+        recv_tensor: Optional[torch.Tensor],
+        start_event: "torch.cuda.Event",
+        end_event: "torch.cuda.Event",
+        wall_start_ns: int,
+        wall_end_ns: int,
+        peers: Optional[List[int]] = None,
+    ) -> None:
+        """Enqueue one event. GPU elapsed time is filled in lazily.
+
+        `peers`: optional list of *global* ranks involved in this comm besides self.
+        For PP this is 1-2 entries (PP-next/PP-prev); for A2A it's all group members.
+        """
+        if not self._enabled:
+            return
+        send_bytes = int(send_tensor.nbytes) if send_tensor is not None else 0
+        recv_bytes = int(recv_tensor.nbytes) if recv_tensor is not None else 0
+        self._enqueue(name, send_bytes, recv_bytes, start_event, end_event,
+                      wall_start_ns, wall_end_ns, peers)
+
+    def record_scalar(
+        self,
+        name: str,
+        send_bytes: int,
+        recv_bytes: int,
+        start_event: "torch.cuda.Event",
+        end_event: "torch.cuda.Event",
+        wall_start_ns: int,
+        wall_end_ns: int,
+        peers: Optional[List[int]] = None,
+    ) -> None:
+        """Like record() but accepts pre-computed byte counts (for P2P where tensors may be None)."""
+        if not self._enabled:
+            return
+        self._enqueue(name, send_bytes, recv_bytes, start_event, end_event,
+                      wall_start_ns, wall_end_ns, peers)
+
+    def flush(self) -> None:
+        """Block until every queued event has completed, write them all, fsync."""
+        self._drain(block=True)
+        if self._file is not None:
+            self._file.flush()
+
+    def close(self) -> None:
+        self._drain(block=True)
+        if self._file is not None:
+            self._file.close()
+            self._file = None
+
+    # ------------------------------------------------------------------
+    # Internal helpers
+    # ------------------------------------------------------------------
+
+    def _enqueue(
+        self,
+        name: str,
+        send_bytes: int,
+        recv_bytes: int,
+        start_event: "torch.cuda.Event",
+        end_event: "torch.cuda.Event",
+        wall_start_ns: int,
+        wall_end_ns: int,
+        peers: Optional[List[int]] = None,
+    ) -> None:
+        self._lazy_init()
+        if self._file is None:
+            return
+        record = {
+            "step": self._step,
+            "rank": self._rank,
+            "local_rank": self._local_rank,
+            "node": self._node_id,
+            "name": name,
+            "gpu_ms": -1.0,  # filled in when the end event is ready
+            "wall_start_us": wall_start_ns // 1000,
+            "wall_end_us": wall_end_ns // 1000,
+            "wall_dur_us": (wall_end_ns - wall_start_ns) // 1000,
+            "send_bytes": send_bytes,
+            "recv_bytes": recv_bytes,
+            "send_MB": round(send_bytes / 1048576, 4),
+            "recv_MB": round(recv_bytes / 1048576, 4),
+        }
+        if peers is not None:
+            # List of global peer ranks; node/local_rank derivable via header's
+            # local_world_size (node = r // lws, local_rank = r % lws).
+            record["peers"] = list(peers)
+        self._pending.append((record, start_event, end_event))
+        # Best-effort, non-blocking drain so the queue stays small.
+        self._drain(block=False)
+
+    def _drain(self, block: bool) -> None:
+        """Drain the pending queue in FIFO order.
+
+        Non-blocking: stops at the first head whose end event is not yet complete.
+        Blocking: synchronizes on each end event so every queued entry is emitted.
+        """
+        if self._file is None:
+            return
+        while self._pending:
+            record, start_ev, end_ev = self._pending[0]
+            if not block and not end_ev.query():
+                # Head still in flight; preserve ordering by waiting until next drain.
+                return
+            if block:
+                end_ev.synchronize()
+            try:
+                record["gpu_ms"] = round(start_ev.elapsed_time(end_ev), 4)
+            except RuntimeError:
+                record["gpu_ms"] = -1.0
+            self._file.write(json.dumps(record) + "\n")
+            self._pending.popleft()
+
+    def _lazy_init(self) -> None:
+        if self._init_done:
+            return
+        self._init_done = True
+        if dist.is_initialized():
+            self._rank = dist.get_rank()
+            self._world_size = dist.get_world_size()
+        else:
+            self._rank = int(os.environ.get("RANK", 0))
+            self._world_size = int(os.environ.get("WORLD_SIZE", 1))
+        self._local_rank = int(os.environ.get("LOCAL_RANK", "0"))
+        self._local_world_size = int(os.environ.get(
+            "LOCAL_WORLD_SIZE",
+            os.environ.get(
+                "SLURM_NTASKS_PER_NODE",
+                str(torch.cuda.device_count() if torch.cuda.is_available() else 1),
+            ),
+        ))
+        if self._local_world_size > 0:
+            self._node_id = self._rank // self._local_world_size
+        self._hostname = socket.gethostname()
+        if self._enabled:
+            os.makedirs(self._log_dir, exist_ok=True)
+            path = os.path.join(self._log_dir, f"comm_rank{self._rank:04d}.jsonl")
+            self._file = open(path, "a", buffering=1)  # line-buffered, appends on resubmit
+            # Ensure the tail of the deferred queue is drained on interpreter exit.
+            atexit.register(self.close)
+            # Session-header line so analysis tools can resolve (peer_rank → node,
+            # local_rank) without contacting other ranks. One per session, so a
+            # resubmitted run produces multiple header lines in the same file.
+            self._file.write(json.dumps({
+                "meta": True,
+                "rank": self._rank,
+                "local_rank": self._local_rank,
+                "node": self._node_id,
+                "hostname": self._hostname,
+                "world_size": self._world_size,
+                "local_world_size": self._local_world_size,
+            }) + "\n")
